<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="0dp"
        android:paddingRight="0dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="14dp">
            <TextView
                android:textSize="@dimen/isHidenTextSize"
                android:textColor="?android:attr/textColorPrimary"
                android:gravity="center"
                android:id="@+id/notification_count"
                android:background="@drawable/shape_notification_count"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginTop="2dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"/>
            <RelativeLayout
                android:background="@drawable/ic_guest_bg"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_centerHorizontal="true"> android:layout_centerHorizontal=&quot;true&quot; 
                <com.prism.hide.ui.widgets.CoverLoadingIconView
                    android:id="@+id/item_app_icon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:scaleType="fitXY"
                    android:layout_centerInParent="true"
                    app:loading_background="#cc233333"
                    app:loading_corner_radius="40dp"/>
            </RelativeLayout>
            <LinearLayout
                android:paddingRight="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true">
                <TextView
                    android:textSize="@dimen/isHidenTextSize"
                    android:gravity="center"
                    android:id="@+id/isHiden"
                    android:background="@drawable/selector_dual_or_hiden"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_marginTop="2dp"
                    android:text="Hiden"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/isHidenTextSize"
                android:textColor="?android:attr/textColorPrimary"
                android:gravity="center"
                android:id="@+id/ad_flag"
                android:background="@drawable/shape_ad_flag"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginTop="2dp"
                android:text="AD"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="?android:attr/textColorPrimary"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/item_app_name"
            android:focusableInTouchMode="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="0dp"
            android:lines="2"/>
    </LinearLayout>
</FrameLayout>
