<?xml version="1.0" encoding="utf-8"?>
<com.gaia.ngallery.ui.widget.photoview.CustomTagedFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.gaia.ngallery.ui.widget.photoview.AttacherImageView
            android:layout_gravity="center"
            android:id="@+id/preview_video_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.gaia.ngallery.ui.widget.photoview.CustomTagedImageView
            android:layout_gravity="center"
            android:id="@+id/preview_video_play_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/play"/>
    </FrameLayout>
</com.gaia.ngallery.ui.widget.photoview.CustomTagedFrameLayout>
