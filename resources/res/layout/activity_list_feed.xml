<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <android.support.design.widget.AppBarLayout
        android:id="@+id/abl_appbar"
        android:background="@drawable/bg_feed_top"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <android.support.v7.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            style="?attr/feedToolbarStyle"/>
    </android.support.design.widget.AppBarLayout>
    <com.prism.hider.module.feed.ui.SwipeFeedView
        android:id="@+id/sfv_feed"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include layout="@layout/content_list_feed"/>
</android.support.design.widget.CoordinatorLayout>
